{
    "name": "Zorin OS Environment",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "version": "latest",
            "desktopDesktop": "xfce"
        }
    },
    "forwardPorts": [6080],
    "postCreateCommand": "bash .devcontainer/install-zorin.sh"
}